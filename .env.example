# Process environment variables override this file. Provider/model choices saved
# in the settings UI take priority over these defaults.
# Provider API key. The key is read from the env var matching the configured
# host (see PROVIDER_KEYS in subtitle_app.py), or from AI_API_KEY for any other
# OpenAI-compatible endpoint.
AI_API_KEY=

# Only needed when the default provider is Gemini, which is the shipped default.
GEMINI_API_KEY=

# Optional: point the manager at another OpenAI-compatible endpoint.
# AI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# Optional model overrides.
# AI_MODEL=gemini-3.5-flash-lite
# AI_PROFILE_MODEL=

# Total request cap: compact Unicode JSON characters, NOT model tokens or bytes.
# Includes system, schema, metadata, selected memory, source and drafts.
# AI_INPUT_CHARS=24000
# Relevant film/episode facts per request; stored profiles remain complete.
# AI_MEMORY_CHARS=6000
# Smaller source budgets are also subject to the total request cap above.
# AI_CONTEXT_CHARS=8000
# AI_PROFILE_CONTEXT_CHARS=8000
# Fixed target batch size; never reduced automatically for input/output budgets.
# AI_BATCH_SIZE=80
# AI_PARALLEL=3
# Output token cap; truncated replies retry the same remaining target IDs.
# AI_MAX_OUTPUT_TOKENS=8192
# Timeout per AI HTTP request in seconds; transient failures have bounded retries.
# AI_REQUEST_TIMEOUT=180
# Extra review for pronouns, historical address, meaning, names and possible cue drift.
# Difficult source units can add one isolated grammar call before the review.
# Modes: risk (default), all (every accepted cue), off (disable extra AI calls).
# AI_SEMANTIC_REVIEW=risk
# Arbiter: when the independent review and the first draft really disagree (more than a cosmetic
# edit), one extra call picks the better text per cue. Any failure keeps the review text.
# on (default) | off
# AI_ARBITER=on
