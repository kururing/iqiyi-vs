{
  "manifest_version": 3,
  "name": "iQIYI Vietnamese",
  "version": "1.2.15",
  "minimum_chrome_version": "120",
  "description": "Dịch giao diện và phụ đề iQIYI sang tiếng Việt",
  "host_permissions": ["<all_urls>"],
  "permissions": ["declarativeNetRequestWithHostAccess", "proxy", "alarms", "webRequest", "webRequestAuthProvider"],
  "background": {"service_worker": "proxy.js"},
  "declarative_net_request": {
    "rule_resources": [
      {"id": "https_resources", "enabled": true, "path": "https-rules.json"}
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://iqiyi.com/*",
        "https://*.iqiyi.com/*",
        "https://iq.com/*",
        "https://*.iq.com/*"
      ],
      "js": ["vi-dict.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://iqiyi.com/*",
        "https://*.iqiyi.com/*",
        "https://iq.com/*",
        "https://*.iq.com/*"
      ],
      "js": ["sub-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
