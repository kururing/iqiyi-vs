# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Runtime data & local state ---
# The subtitle library is created at runtime from the user's own account;
# it is never packaged with the project.
subtitles/library/
subtitles/international/
*.lock
*.pid
*.log

# Transient caches and per-run snapshots
.tmp/
ext/_metadata/
live-vietsub-cache.json
vi-live.json
subtitle-context-cache.json
dict-current.json
native-caption-check.json
subtitle-runtime-verified.json
untranslated-strings.json
watch-iqiyi-vi.disabled

# --- Secrets & user configuration ---
.env
.ai-settings.json
.iqiyi-vi-token
ext/proxy-token.json

# --- Local-only development assets ---
# Translation bodies extracted from a licensed client, and override tables for
# patches built against a specific install. Not part of the shipped project.
.local/

# --- Installed-app backups created by apply-vi.py while patching ---
backup-skin/
backup-lwa/
backup-ppstream.ini
versions/

# --- Editor / OS noise ---
.vs/
.vscode/
.idea/
Thumbs.db
desktop.ini
