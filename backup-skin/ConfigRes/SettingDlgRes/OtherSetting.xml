<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Window>
    <Font name="微软雅黑" size="12" bold="false" italic="false" default="true"/>
    <Font name="微软雅黑" size="10" bold="false" italic="false" indexfont="yahei_10"/>
    <Container name="OtherSettingContainer" width="416" height="310" inset="0,0,0,0">
        <VerticalLayout>
            <Label text="消息通知:" padding="0,0,0,0" width="200" height="18" textpadding="0,-1,0,0" textcolor="config_txt_hot" font="yahei_14"/>
            <HorizontalLayout padding="0,16,34,0" height="14">
                <CheckBox name="os_smallpopwnd" style="checkbox_style" width="132" text="接收预约上线提醒" textpadding="18,-1,0,0"/>
				<CheckBox name="os_content_update" style="checkbox_style" width="132" text="接收内容推荐提醒" textpadding="18,-1,0,0"/>
            </HorizontalLayout>
			<Label text="版本更新:" padding="0,32,0,0" width="200" height="18" textpadding="0,-1,0,0" textcolor="config_txt_hot" font="yahei_14"/>
            <HorizontalLayout  padding="0,16,34,0"  height="14">
                <CheckBox name="os_radioAlwaysKeepNew" style="radio_style" group="group_cfg_update" width="121" text="随时保持最新" textpadding="18,-1,0,0"/>
                <CheckBox name="os_radioNotifyHasNew" style="radio_style" group="group_cfg_update" width="132" text="有更新时提醒我" textpadding="18,-1,0,0"/>
            </HorizontalLayout>
			<VerticalLayout name="os_show_children_container">
				<Label text="顶导航:" padding="0,32,0,0" width="200" height="18" textpadding="0,-1,0,0" textcolor="config_txt_hot" font="yahei_14"/>
				<HorizontalLayout  padding="0,16,34,0"  height="14">
					<CheckBox name="os_show_children_mode" style="checkbox_style" width="132" text="显示少儿模式" textpadding="18,0,0,0"/>
					<CheckBox name="os_weather_mode" style="checkbox_style" width="132" text="显示天气" textpadding="18,0,0,0"/>
				</HorizontalLayout>
			</VerticalLayout>
        </VerticalLayout>
    </Container>
</Window>
