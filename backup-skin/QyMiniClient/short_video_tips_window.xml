<?xml version="1.0" encoding="utf-8"?>
<Window size="155,75" sizebox="0,0,0,0" caption="0,0,0,0">
  <Font name="Microsoft YaHei" size="12" bold="false" italic="false" indexfont="yahei_12" />
  <Font name="Microsoft YaHei" size="14" bold="false" italic="false" indexfont="yahei_14" />
    
    <!-- 主容器 -->
    <HorizontalLayout padding="0,0,0,0">
        <!-- 左侧箭头区域 -->
        <Label name="arrow_left" width="6" height="12" bkimage="file='1385/arrow_left.svg'" visible="true"/>
        <!-- 内容区域 -->
        <HorizontalLayout bkcolor="#FF292C33" borderround="8,8">
            <!-- 图片区域 -->
            <OnlineVerticalLayout name="tips_image" width="43" height="57" padding="8,8,0,8" borderround="4,4"/>
            
            <!-- 文本内容区域 -->
            <VerticalLayout padding="8,8,0,0">
                <Label name="first_line" text="提示文本" textcolor="#FFFFFFFF" font="yahei_14" align="left"/>
				<Label name="second_line" text="提示文本" textcolor="#FFFFFFFF" font="yahei_14" align="left" endellipsis="true"/>
				<Button name="play_btn" text="立即观看" indexfont="yahei_12" width="154" height="28"  padding="0,6,12,0"
                  textcolor="#FFFFFFFF"  hottextcolor="#FFFFFFFF" pushedtextcolor="#FFFFFFFF" disabledtextcolor="#FFFFFFFF" 
                  gradient="linear startpoint='0,0.5' endpoint='1,0.5' colorstops=((#ff00a8e6, 0) (#ff00b84d,0.5) (#ff00b84d, 1.0))"
                  hot-gradient="linear startpoint='0,0.5' endpoint='1,0.5' colorstops=((#ff1ac1ff, 0) (#ff00cc55, 0.5) (#ff00cc56, 1.0))"
                  pushed-gradient="linear startpoint='0,0.5' endpoint='1,0.5' colorstops=((#ff0082b3, 0) (#ff009940,0.5) (#ff009940, 1.0))" borderround="20,20,20,20"/> 
            </VerticalLayout>
			 <Button name="close_btn" width="12" height="12" padding="8,6,8,0" bkimage="file='1385/close.svg' svg-fill-color='#BFFFFFFF'
            hot-svg-fill-color='#80FFFFFF'
            pushed-svg-fill-color='#80FFFFFF'"/>
        </HorizontalLayout>
        
        <!-- 右侧箭头区域 -->
        <Label name="arrow_right" width="6" height="12" bkimage="file='1385/arrow_right.svg'" visible="true"/>
    </HorizontalLayout>
</Window>
