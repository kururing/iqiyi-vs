<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Window width="464" height="423">
  <Font name="Microsoft YaHei" size="12" bold="false" italic="false" indexfont="yahei_12" />
  <Font name="Microsoft YaHei" size="14" bold="false" italic="false" indexfont="yahei_14" />
  <Font name="Microsoft YaHei" size="16" bold="false" italic="false" indexfont="yahei_16" />
  <Font name="Microsoft YaHei" size="20" bold="false" italic="false" indexfont="yahei_20" />
  <!-- 极简模式永久退出确认浮层，整体 464x423，圆角深色卡片 -->
  <CxVerticalLayout name="root_lay"
                    width="464"
                    height="423"
                    bkcolor="#e61c1d1f"
                    borderround="16,16">

          <!-- 右上角关闭按钮（仅关闭浮层，不做永久退出） -->
    <Button name="close_btn" width="16" height="16" padding="432,16,0,0"
			normalimage="file='close.svg' dest='0,0,16,16' svg-fill-color='0xBFFFFFFF'"
			hotimage="file='close.svg' dest='0,0,16,16' svg-fill-color='0xFFFFFFFF'"
			pushedimage="file='close.svg' dest='0,0,16,16' svg-fill-color='0x80FFFFFF'"/>
	<!-- 标题 -->
    <VerticalLayout width="464" height="50">
      <Label name="title_lab_1"
             text="极简模式已永久关闭"
             indexfont="yahei_20"
             textcolor="#ffffffff"
			 align="center"
             height="20" />
      <Label name="title_lab_2"
             text="后续可在爱奇艺菜单中重新打开极简模式"
             indexfont="yahei_14"
             textcolor="#99ffffff"
             height="14" 
			 align="center"
			 padding="0,12,0,0"/>
    </VerticalLayout>

    <Label name="content"
		     width="400"
             height="225"
			 padding="32,20,0,0"
			 bkimage="quit_confirm_content.png"/>

	<Button name="iknow"
              width="400"
              height="48"
              padding="32,20,0,0"
              text="我知道了"
              textcolor="#FFFFFFFF"
              indexfont="yahei_16"
              borderround="24,24"
			  gradient="linear startpoint='0,0.5' endpoint='1,0.5' colorstops=((#ff00a8e6, 0) (#ff00b84d,0.5) (#ff00b84d, 1.0))"
              hot-gradient="linear startpoint='0,0.5' endpoint='1,0.5' colorstops=((#ff1ac1ff, 0) (#ff00cc55, 0.5) (#ff00cc56, 1.0))"
              pushed-gradient="linear startpoint='0,0.5' endpoint='1,0.5' colorstops=((#ff0082b3, 0) (#ff009940,0.5) (#ff009940, 1.0))"
              disabled-gradient="linear startpoint='0,0.5' endpoint='1,0.5' colorstops=((#ff0082b3, 0) (#ff009940,0.5) (#ff009940, 1.0))"/>
  </CxVerticalLayout>
</Window>

