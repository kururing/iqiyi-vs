<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Window>
  <Font name="微软雅黑" size="12" bold="false" italic="false" indexfont="yahei_12" />
  <Font name="微软雅黑" size="14" bold="false" italic="false" indexfont="yahei_14" />
  <Font name="微软雅黑" size="16" bold="false" italic="false" indexfont="yahei_16" default="true" />
  <Font name="微软雅黑" size="18" bold="false" italic="false" indexfont="yahei_18" />
  <Font name="微软雅黑" size="20" bold="false" italic="false" indexfont="yahei_20" />
  <Font name="微软雅黑" size="22" bold="false" italic="false" indexfont="yahei_22" />
  <Font name="微软雅黑" size="24" bold="false" italic="false" indexfont="yahei_24" />

  <VerticalLayout name="RenderWindow" bkcolor="0xFF000000" bkimage="player/public/ctrl/bk.png">
    <!--Container name="PlayTop" height="29" /-->
    <!--bkimage="file='player/MiniPlayer/Top/bk.png' corner='1,1,20,20'"-->
    <!--Label name="middle_watermark" float="true" width="0" height="0" bkimage="file='player/MiniPlayer/Middle/watermark.png'" /-->
    <VerticalLayout name="audio">
      
    <HorizontalLayout name="hlay_lryic" visible="true" paddding="10,10,10,10" bkimage="file='player/miniplayer/other/lyric/lyric_cover.png'">
      <HorizontalLayout name="hlay_lryic_layout" padding="131,80,100,104">
        <HorizontalLayout name="hlay_cover" >
          <Control />
          <VerticalLayout name="lyric_cover_layout" width="410">
            <Control />
            <Control name="lyric_cover" width="410" height="410"
                   bkimage="file='player/miniplayer/other/lyric/lyric_cover.png'"
           userdata="file='player/miniplayer/other/lyric/lyric_cover.png'" />
            <Control />
          </VerticalLayout>
          <Control />
        </HorizontalLayout>

        <AnimScrollVerticalLayout name="vlay_lrcs" visible="false" width="619"  align="right" />
      </HorizontalLayout>
 
	  <VerticalLayout name="vlay_lyric_notfind" visible="false">
		<Control />		
		<Label text="   抱歉，没找到歌词。"  textcolor="0xFFCCCCCC" height="30" align="leftmiddle" textpadding="25,0,0,0" /> 
			<HorizontalLayout height="30">		
			<Label text="您可以尝试" textcolor="0xFFCCCCCC" width="92" align="leftmiddle" />
			<Button name="lyric_load" text="载入歌词文件" textcolor="0xFF04b000" width="120" align="leftmiddle" />
			</HorizontalLayout>		
		<Control />
	  </VerticalLayout>	  
	  
	  <Label name="vlay_lyric_searching" visible="false" text="正在搜索歌词，请稍候..."  textcolor="0xFFCCCCCC" align="leftmiddle"  /> 

      <HorizontalLayout name="hlay_seek" float="true" maxheight="15" height="15" visible="false">	 	  
        <Button name="lyric_play" width="10" height="11" align="right" padding="0,2,0,2"
             normalimage="file='player/miniplayer/other/lyric/lyric_play.png' source='0,0,10,11'"
             hotimage="file='player/miniplayer/other/lyric/lyric_play.png' source='0,11,10,22'"
             pushedimage="file='player/miniplayer/other/lyric/lyric_play.png' source='0,22,10,33'"
        />
        <Label  name="lyric_line" height="1" bkcolor="0xFF026600" padding="8,7,8,7" />
        <Label  name="lyric_time" width="55" align="leftmddile" fontindex="yahei_12" textcolor="0xFF026600" />
      </HorizontalLayout> 
	 
    </HorizontalLayout>
	
	<Container name="lyric_nolrc" visible="false">
	  	<Label name="lab_cover_nolrc" width="215" height="215" visible="true" float="true" 
		  maxwidth="215" minwidth="215" maxheight="215"  minheight="215"
          bkimage="file='player/miniplayer/other/lyric/lyric_cover.png'"
		  userdata="file='player/miniplayer/other/lyric/lyric_cover.png'"
		/>
	</Container>
	</VerticalLayout>
    <VerticalLayout name="mid_dlna" visible="false" gradient="linear startpoint='0,0' endpoint='1,1' colorstops=((#FF192A2C, 0) (#FF091C0D, 1.0))">
      <VerticalLayout name="dlna_layout" width="758" height="508">
      <VerticalLayout name="dlna_bk" width="758" height="371" bkimage="file='geeIcon/dlna/dlna_connecting.png' ">
        <Control />
        <Label name="labDlnaUuid" align="center" endellipsis="true" textcolor="#F2FFFFFF" indexfont="yahei_16" padding="197,0,197,0"  width="364" height="22"/>
        <RichEdit name="labDlnaVideo"  singleline="false" endellipsis="true" align="center" padding="197,16,197,0"  width="364" height="66" multiline="true"
               textcolor="#F2FFFFFF" indexfont="yahei_16"/>
        <Label name="dlna_discon_lab1" visible="false" text="投屏已断开" align="center" endellipsis="true" textcolor="#F2FFFFFF" indexfont="yahei_20b" />
        <Label  name="dlna_discon_lab2" visible="false" text="与电视的链接断开了，请尝试重新投屏" align="center" endellipsis="true" textcolor="#99FFFFFF" indexfont="yahei_16"/>
        <Control />
        </VerticalLayout>
      <HorizontalLayout name="btn_layout" height="40" width="344" padding="207, 32, 0, 0">
        <Button name="dlna_switch" width="160" height="40"	text="退出投屏"    indexfont="yahei_14"
textcolor="#F2FFFFFF"  hottextcolor="#FFFFFFFF" pushedtextcolor="#99FFFFFF"
bordercolor="#14FFFFFF" bkcolor="#0FFFFFFF" hotbkcolor="#1AFFFFFF" pushedbkcolor="#0AFFFFFF" borderround="20,20,20,20"/>
        <Button name="device_switch" width="160" height="40"	text="更换设备"  padding="24,0,0,0"  indexfont="yahei_14"
textcolor="#F2FFFFFF"  hottextcolor="#FFFFFFFF" pushedtextcolor="#99FFFFFF"
bordercolor="#14FFFFFF" bkcolor="#0FFFFFFF" hotbkcolor="#1AFFFFFF" pushedbkcolor="#0AFFFFFF" borderround="20,20,20,20"/>
      </HorizontalLayout>
      <Label name="lab_tip" text="如果投屏失败，可能是连接的设备不支持该文件格式" width="278" height="18" padding="240,48,240,0" indexfont="yahei_12" endellipsis="false" textcolor="0x99FFFFFF"/>

      </VerticalLayout>
    </VerticalLayout>
  </VerticalLayout>
</Window>

