<?xml version="1.0" encoding="UTF-8"?>
<Window>
<HistoryItem height="28" >
  <HorizontalLayout height="28">
    <Control name="icon" width="12"  height="12" padding="12,8,0,0" />
    <HorScrollLabel name="name" align="leftmiddle" width="173" padding="8,0,0,0" textcolor="history_item_text" endellipsis="true" />
    <Control width ="0" />
    <Label  name="label_tip" width="96" text="正在播放" align="right" textcolor="history_btn_text" visible="false" />
    <CheckBox name="check_play" animation="false" width="13" height="13" visible="false" padding="37,8,0,0" 
            normalimage="file='skinplan\history/play.png' source='0,0,13,13'"
            hotimage="file='skinplan\history/play.png'  source='13,0,26,13'"
            pushedimage="file='skinplan\history/play.png'  source='13,0,26,13'"
            selectednormalimage="file='skinplan\history/pause.png'  source='0,0,13,13'"
            selectedhotimage="file='skinplan\history/pause.png' source='13,0,26,13'"
            selectedpushedimage="file='skinplan\history/pause.png' source='13,0,26,13'"
				/>
    <Button name="btn_local" tooltip="打开文件所在位置" visible ="false" width="13" height="13" padding="11,8,0,0" 
            normalimage="file='skinplan\history/folder.png' source='0,0,13,13'"
            hotimage="file='skinplan\history/folder.png' source='13,0,26,13'"
            pushedimage="file='skinplan\history/folder.png' source='13,0,26,13'"/>
    <Button name="history_item_close" width="13" height="13" padding="9,8,0,0" visible="false" tooltip ="删除该条播放记录"
            normalimage="file='skinplan\history/cancel.png' source='0,0,13,13'"
            hotimage="file='skinplan\history/cancel.png' source='13,0,26,13'"
            pushedimage="file='skinplan\history/cancel.png' source='13,0,26,13'"/>
    <Control width="20"/>
  </HorizontalLayout>
</HistoryItem>
</Window>
