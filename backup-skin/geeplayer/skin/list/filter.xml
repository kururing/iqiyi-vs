               selectedtextcolor="color_filteritem_seltext" align="leftmiddle" group="filterstatus" selected="true" />
      <Option name="optPlayed" text="已播"  indexfont="yahei_12"
               textcolor="color_filteritem_nortext" hottextcolor="color_filteritem_seltext"
               selectedtextcolor="color_filteritem_seltext" align="leftmiddle" group="filterstatus" />
      <Option name="optUnPlayed" text="未播"  indexfont="yahei_12" padding="10,0,10,0"
               textcolor="color_filteritem_nortext" hottextcolor="color_filteritem_seltext"
               selectedtextcolor="color_filteritem_seltext" align="leftmiddle" group="filterstatus" />
    </HorizontalLayout>
  </VerticalLayout>
</Window>