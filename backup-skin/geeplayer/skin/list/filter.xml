<?xml version="1.0" encoding="UTF-8"?>
<Window size="11,10" >
  <Include source="public\xml\default_font.xml" />
  <VerticalLayout bkimage="file='skinplan\list/filter/bk.png' corner='5,50,5,5'" inset="15,12,0,0" >
    <Label  text="类型:" align="leftmiddle" textcolor="color_filtertitle_text" indexfont="yahei_12" />
    <HorizontalLayout height="14" padding="0,2,0,0">
      <Option name="optTypeAll" text="全部"  indexfont="yahei_12" padding="0,0,12,0" 
               textcolor="color_filteritem_nortext" hottextcolor="color_filteritem_seltext"
               selectedtextcolor="color_filteritem_seltext" align="leftmiddle" group="filtertype" selected="true" />
      <Option name="optVideo" text="视频"  indexfont="yahei_12" width="35"
               textcolor="color_filteritem_nortext" hottextcolor="color_filteritem_seltext"
               selectedtextcolor="color_filteritem_seltext" align="leftmiddle" group="filtertype" />
      <Option name="optAudio" text="音频"  indexfont="yahei_12" padding="10,0,0,0" width="35"
