    <Label  text="状态:" padding="0,11,0,0" align="leftmiddle" textcolor="color_filtertitle_text" indexfont="yahei_12" />
    <HorizontalLayout height="16" padding="0,2,0,0">
      <Option name="optStatusAll" text="全部"  indexfont="yahei_12" padding="0,0,12,0"
