<?xml version="1.0" encoding="UTF-8"?>
<Window>
	<PicFileItem name="picfileItem" height="91" padding="0,0,0,0" foreimage="file='skinplan\list/itembk.png' fade='26'">
		<Control name="space" width="1"/>
		<VerticalLayout height="91" width="156">
			<HorizontalLayout name="cover" height="83" width="148" bkimage="file='skinplan\list/default_invalidate.png'" borderround="8,8,8,8"
		 padding="0,4,2,0" foreimage="skinplan\list/color.png" >
				<Label name="mask"  float="true" visible="true" width="148" height="38" bkimage="newIcon/FileItem/normal/mask.png" borderround="0,0,8,8"/>
				<Label name="videoTime" height="20" visible="true" textcolor="list_item_text_nor" padding="108,62,0,0"
			   indexfont="yahei_12" />
				<Gifcontrol name="playicon" float="true"  visible="false" width="16" height="16" bkimage="newIcon/FileItem/normal/playing.gif" autoplay="true"/>
			</HorizontalLayout>
		</VerticalLayout >
		<HorizontalLayout>
			<Control name="lastplayed_icon"  bkimage="skinplan\list/watched_icon.png" visible="false" width="16" height="12"
 padding="0,14,0,0" tooltip="上一次播放的文件"/>
			<VerticalLayout name="midlable" height="84" adjustwidth="true">

				<Text name="name" align="leftmiddle" textcolor="list_item_text_nor" adjustwidth="true" adjustheight="true" maxheight="48" minheight="24"  padding="0,23,0,0"
				 indexfont="yahei_16" singleline="false" endellipsis="true" showhtml="true"/>
				<Label name="invalidatelabel" height="20" align="left" text="文件已失效" visible="false" padding="2,0,0,6"
				 width="70" textcolor="0xFFF65175" indexfont="yahei_14"/>

			</VerticalLayout>
			<VerticalLayout name="rightlable" height="84" width="52">
			<CheckBox name="item_playbtn" width="28" height="28" padding="10,15,0,0"
	   animation="true" visible="false"
	   normalimage="file='newIcon/FileItem/normal/play_btn.png' source='0,0,56,56'"
	   hotimage="file='newIcon/FileItem/hover/play_btn.png' source='0,0,56,56'"
	   pushedimage="file='newIcon/FileItem/press/play_btn.png' source='0,0,56,56'"
	   selectednormalimage="file='newIcon/FileItem/normal/pause_btn.png' source='0,0,56,56'"
	   selectedhotimage="file='newIcon/FileItem/hover/pause_btn.png' source='0,0,56,56'"
	   selectedpushedimage="file='newIcon/FileItem/press/pause_btn.png' source='0,0,56,56'" />
			<Button name="item_closebtn" visible="false" width="28" height="28"  tooltip="从播放列表中删除" padding="10,5,0,0"
			   normalimage="file='newIcon/FileItem/normal/delete.png' source='0,0,56,56'"
			   hotimage="file='newIcon/FileItem/hover/delete.png' source='0,0,56,56'"
			   pushedimage="file='newIcon/FileItem/press/delete.png' source='0,0,56,56'"/>
			</VerticalLayout>

		</HorizontalLayout>
	</PicFileItem>
</Window>