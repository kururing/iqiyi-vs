<?xml version="1.0" encoding="UTF-8"?>
<Window>
	<ListContainerElement name="fileItem " height="40" >
	    <HorizontalLayout name="filehorz">
			<Control name="ctrl_playing" width="2" visible="false" />
			<Control name="playicon" visible="false" width="15" height="15" padding="8,7,5,8"/>
			<Label name="filename" height="40" width="532" align="leftmiddle" padding="32,0,0,0" textcolor="0xFF888888" disabledtextcolor="0xFFFFFFFFF" indexfont="yahei_16" 
				endellipsis="true" />
			<Label name="file_playtime" height="40" visible="true" align="right"  padding="0,0,32,0" textcolor="0xFF888888" 
				indexfont="yahei_14" minheight="40"/>
			<Label name="invalidatelabel" height="40" text="文件无效" visible="false" width="50" padding="5,0,0,0" textcolor="0xFFC70000"
				indexfont="yahei_12"/>
			<Button name="item_playbtn" visible="false" width="27" text="播放" height="40" padding ="3,0,0,0" align="leftmiddle" 
				textcolor="0xffCCCCCC" hottextcolor="0xff45b000" pushedtextcolor="0xff2d7300" 
				disabledtextcolor="0xFFFFFFFFF" indexfont="yahei_16"/>
			<Button name="item_closebtn" visible="false" width="7" height="7" padding="7,12,0,0"
				normalimage="file='list/close.png' source='0,0,7,7'"
				hotimage="file='list/close.png' source='7,0,14,7'"
				pushedimage="file='list/close.png' source='14,0,21,7'"/>
		</HorizontalLayout>
	</ListContainerElement>
</Window>