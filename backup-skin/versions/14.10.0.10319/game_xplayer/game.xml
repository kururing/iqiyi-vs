<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Window >
    <Font name="Microsoft YaHei" size="8" bold="false" italic="false" indexfont="yahei_8" />
    <Font name="Microsoft YaHei" size="9" bold="false" italic="false" indexfont="yahei_9" />
    <Font name="Microsoft YaHei" size="10" bold="false" italic="false" indexfont="yahei_10" />
    <Font name="Microsoft YaHei" size="11" bold="false" italic="false" indexfont="size_11" />
    <Font name="Microsoft YaHei" size="12" bold="false" italic="false" default="true" indexfont="yahei_12" />
    <Font name="Microsoft YaHei" size="12" bold="false" italic="false" indexfont="no_underline_font"/>
    <Font name="Microsoft YaHei" size="12" bold="false" italic="false" underline="true" indexfont="underline_font" />
    <Font name="Microsoft YaHei" size="13" bold="false" italic="false" indexfont="yahei_13" />
    <Font name="Microsoft YaHei" size="13" bold="true" italic="false" indexfont="yahei_13_bold" />
    <Font name="Microsoft YaHei" size="14" bold="false" italic="false" indexfont="yahei_14" />
    <Font name="Microsoft YaHei" size="14" bold="true" italic="false" indexfont="yahei_14_bold" />
    <Font name="Microsoft YaHei" size="16" bold="false" italic="false" indexfont="yahei_16" />
    <Font name="Microsoft YaHei" size="23" bold="true" italic="false" indexfont="yahei_23_bold" />

    <VerticalLayout name="root" minwidth="270" minheight="420" maxheight="486" bkimage="file=&apos;commonres/bk_tip.svg&apos; svg-fill-color='tip_bkcolor' corner=&apos;30,30,30,30&apos; "  >
        <VerticalLayout>
            <Control height="20" />
            <VerticalLayout name="gameTask" visible="false" width="230" height="66" minheight="66" padding="20,0,20,0" >
                <Control height="6" />
                <HorizontalLayout height="20" >
                    <Label name="gameTitle" text="玩游戏领VIP" width="84" height="14" textcolor="integral_title" indexfont="yahei_14" align="leftmiddle" padding="0,3,0,3" />
                    <Label name="gameDot" visible="false" width="6" height="6" bkimage="file='commonres\update_dot.svg'" padding="1,4,0,10" />
                    <Control />
                    <Button name="gamePlay" text="玩游戏" width="52" height="20" align="centermiddle" indexfont="yahei_12" visible="false" borderround="2,2" bordersize="1"
                            textcolor="game_play_text_color" hottextcolor="game_play_text_hot_color"
                            bordercolor="game_play_border_color" hotbordercolor="game_play_border_hot_color" />
                    <Button name="gameComplete" text="领VIP" width="47" height="20" align="centermiddle" indexfont="yahei_12" visible="false" borderround="2,2"
                            textcolor="game_complete_text_color"
                            gradient="game_complete_normal_gradient"
                            hot-gradient="game_complete_hot_gradient" />
                    <Label name="gameOver" text="已完成" visible="false"  width="52" height="20" align="centermiddle" indexfont="yahei_12" borderround="2,2" bordersize="1"
                           textcolor="integral_translucent_text"
                           bordercolor="integral_translucent_text" />
                </HorizontalLayout>
                <HorizontalLayout height="12" padding="0,12,0,0" >
                    <Label name="gameDesc" text="每天玩5分钟，集满15天可兑换月卡" width="190" indexfont="yahei_12" textcolor="integral_subtitle" align="left" />
                    <Control />
                    <Label name="gamePrecent" text="0/30" width="40" align="right" indexfont="yahei_12" textcolor="integral_subtitle"/>
                </HorizontalLayout>
                <HorizontalLayout name="gameProgress" width="230" minwidth="230" height="2" minheight="2"
                                  itemBKColor="integral_progressItem" itemCompleteBKColor="game_task_progress_bk" padding="0,12,0,0" />
                <Control height="2" />
            </VerticalLayout>

            <Label name="default_content_game" visible="false" width="184" height="178" bkimage="file='skinplan/commonres/empty_content.svg' align='center,184,184' decode='render'" padding="43,67,0,0"  />

            <VerticalLayout name="data_content" width="270" visible="false" >
                <Item height="102" width="270" visible="false" padding ="0,16,0,0" >
                    <Control />
                    <Control name="pic" width="230" borderround="2,2" bkcolor="logo_bk_color" bkimage="file='commonres/logo.svg' align='center,33,22' svg-fill-color='logo_fore_color'"/>
                    <Control />
                </Item>
                <Item height="102" width="270" visible="false" padding ="0,16,0,0" >
                    <Control />
                    <Control name="pic" width="230" borderround="2,2" bkcolor="logo_bk_color" bkimage="file='commonres/logo.svg' align='center,33,22' svg-fill-color='logo_fore_color'"/>
                    <Control />
                </Item>
                <Item height="102" width="270" visible="false" padding ="0,16,0,0" >
                    <Control />
                    <Control name="pic" width="230" borderround="2,2" bkcolor="logo_bk_color" bkimage="file='commonres/logo.svg' align='center,33,22' svg-fill-color='logo_fore_color'"/>
                    <Control />
                </Item>
            </VerticalLayout>
        </VerticalLayout>

        <Button name="more" width="56" height="14" padding="97,16,0,16" text="查看更多" indexfont="yahei_14"
                textcolor="Game_xplayer_textcolor" hottextcolor="Game_xplayer_hottextcolor" pushedtextcolor="Game_xplayer_hottextcolor"/>

        <VerticalLayout name="toast" visible="false" width="165" height="48" float="true" pos="85,42,250,126" placeholder="true">
            <Control height="8" />
            <Label name="toastSuccess" indexfont="yahei_14" align="centermiddle" textcolor="#FFFFFFFF" visible="false" height="40" bkcolor="game_toast_bk" borderround="2,2"  />
            <Label name="toastFailed" text="领取失败,请稍后重试" indexfont="yahei_14" align="centermiddle" textcolor="#FFFFFFFF" visible="false" height="40" bkcolor="game_toast_bk" borderround="2,2" />
            <Label width="14" height="9" float="true" pos="135,0,69,9" bkimage="file='userinfo/res/arrows.svg' svg-fill-color='game_toast_bk' " />
        </VerticalLayout>
    </VerticalLayout>
</Window>