<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Window width="420" height="236">
  <Font name="Microsoft YaHei" size="12" bold="false" italic="false" indexfont="yahei_12" />
  <Font name="Microsoft YaHei" size="14" bold="false" italic="false" indexfont="yahei_14" />
  <Font name="Microsoft YaHei" size="16" bold="false" italic="false" indexfont="yahei_16" />
  <Keyframe name="up_key" value="{'from':{'bottom':420},'to':{'top':0}}"/>

  <CxVerticalLayout name="root_lay" width="420" height="236" borderround="8,8" bkcolor="#ff1E2126" >
	<!--播放器-->
	 <VerticalLayout name="video_root_lay" float="true" width="420" height="236" BorderRadius="4" pos="0,0,420,236" bkimage111="file='loading.webp' dest='130,78,290,158'">
	 </VerticalLayout>
	<!--静音按钮阴影-->
	<Label width="70" height="53" gradient="linear startpoint='0.2,0' endpoint='0.54,0.65' colorstops=((#2e000000, 0) (#00000000, 1)" float="true" pos="0,0,70,53" bkimage="volume_bk.png"/>
	
	<CheckBox name="volume_btn" selected="false" padding="8,8,0,0" width="35" height="35" visible="false" borderround="16,16"
		bordersize="1"
		hotbordercolor="#33ffffff" pushedbordercolor="#1affffff"

		normalimage="file='volume_off.svg' align='center,24,24'  svg-fill-color='#ccffffff'" 
		hotimage="file='volume_off.svg' align='center,24,24'  svg-fill-color='#ffffffff'" 
		pushedimage="file='volume_off.svg' align='center,22,22'" 
		
		selectednormalimage="file='volume.svg' align='center,24,24'  svg-fill-color='#ccffffff'" 
		selectedhotimage="file='volume.svg' align='center,24,24'  svg-fill-color='#ffffffff'" 
		selectedpushedimage="file='volume.svg' align='center,22,22'" 
	/>
	<!-- 底部阴影-->
	<VerticalLayout width="420" height="40" gradient="linear startpoint='0.5,0' endpoint='0.5,1' colorstops=((#00000000, 0) (#ff000000, 1)" alpha="127" float="true" pos="0,196,420,236">
	</VerticalLayout>
	<HorizontalLayout name="video_info_lay" height="40" padding="0,135,0,20">
		<!-- 标题-->
		<VerticalLayout name="title_lay" maxwidth="204" height="37" padding="16,3,0,0">
			<HorizontalLayout height="18">
				<Label name="video_name" align="left" indexfont="yahei_16" height="16" endellipsis="true" textcolor="#ffffffff" visible="false"/>
				<Label name="video_lab" bkcolor="#ff7c9fff" borderround="4,4" padding="4,0,0,0" width="44" height="18" textcolor="#ffffffff" align="center" indexfont="yahei_12" textpadding="4,0,4,0" visible="false"/>
			</HorizontalLayout>
			<Label name="sub_title" height="12" indexfont="yahei_12" textcolor="#ccffffff" padding="0,7,0,0" visible="false" endellipsis="true"/>
		</VerticalLayout>
		<Button name="title_play_btn" width="204" height="37" padding="-204,3,0,0"/>
		<Control />
		<!--收藏-->
		<HorizontalLayout width="40" height="40" padding="12,0,0,0">
			<CheckBox name="favorite_btn" width="40" height="40" borderround="20,20" bordersize="1" 
			bordercolor="#26ffffff" hotbordercolor="#4dffffff" pushedbordercolor="#1affffff"
			bkcolor="#e6292c33" hotbkcolor="ff45484d" pushedbkcolor="ff1e2126"
			
			normalimage="file='favorite.svg' align='center,20,20' svg-fill-color='#ccffffff'" 
			hotimage="file='favorite.svg' align='center,20,20' svg-fill-color='#ffffffff'" 
			pushedimage="file='favorite_selected.svg' align='center,18,18' svg-fill-color='#b3ffffff'" 
			
			selectednormalimage="file='favorite_selected.svg' align='center,20,20'  svg-fill-color='#ccffffff'" 
			selectedhotimage="file='favorite_selected.svg' align='center,20,20'  svg-fill-color='#ffffffff'" 
			selectedpushedimage="file='favorite.svg' align='center,18,18' svg-fill-color='#b3ffffff'" 
			
			pushed-gradient="linear startpoint='0.5,0' endpoint='0.46,0.92' colorstops=((#52000000, 0) (#1f000000, 1)"
			 visible="false"/>
		</HorizontalLayout>

		<Button name="play_btn" width="120" height="40" bkcolor="#e6292c33" bordercolor="#1affffff" bordersize="1" borderround="20,20"  hotbkcolor="ff45484d" pushedbkcolor="ff1e2126"
		bkimage="file='play_video.svg'  dest='24,12,40,28'" text="看正片" textpadding="8,0,0,0"  indexfont="yahei_16" textcolor="#ffffffff" padding="12,0,16,0" visible="false"/>
	</HorizontalLayout>
	<Slider name="watch_progress" width="420" maxheight="8"  float="true" pos="0,228,420,236" forecolor="#FF8EED00"  visible="false" bkcolor="#33ffffff" foregradient="linear startpoint='0,0.5' endpoint='1,0.5' colorstops=((#ff1f9dc8, 0) (#ff1dd14a, 0.51) (#ff1dd14a, 1)" maxheight="8" forepadding="0,4,0,0" borderround="2,2" bkpadding="0,4,0,0"
	thumbsize="15,15" thumbhotimage="thumb.png"  thumbbase="center"/>
	<Label name="cur_time_lab" textcolor="#e6ffffff" visible="false" float="true" pos="16,212,116,224" indexfont="yahei_12"/>
    <Label name="total_time_lab" textcolor="#e6ffffff" visible="false" float="true" pos="344,212,404,224" align="right"
	 indexfont="yahei_12"/>
	
	<VerticalLayout width="22" height="66" float="true" pos="388,12,410,78"  gradient="linear startpoint='0.5,0' endpoint='0.5,0.97' colorstops=((#0affffff, 0) (#05ffffff, 1)" >
		<VerticalLayout bkimage="up_bk.png" width="22" height="33">
		    <Button name="up_btn" bkimage="file='arrow_up.svg' align='center,16,16'" width="22" height="33" alpha="230"/>
		</VerticalLayout>
		<VerticalLayout bkimage="down_bk.png" width="22" height="33">
		    <Button name="down_btn" bkimage="file='arrow_down.svg' align='center,16,16'" width="22" height="33"/>
		</VerticalLayout>
	</VerticalLayout>
	<Button name="play_pause_btn" width="64" height="64" borderround="32" bkimage="file='play_video.svg' align='center,32,32'" float="true" pos="178,86,242,150" visible="false" bkcolor="#66000000" bordercolor="#26ffffff"/>
  </CxVerticalLayout>
</Window>
