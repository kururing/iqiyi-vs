<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Window >
  <Font name="Microsoft YaHei" size="12" bold="false" italic="false" indexfont="yahei_12" />
  <Font name="Microsoft YaHei" size="14" bold="false" italic="false" indexfont="yahei_14" />
  <VerticalLayout>
	  <!--缩略态-->
	  <CxVerticalLayout name="thumbnail_lay" width="72" height="72" borderround="16,16" bkcolor="#66000000">
		  <Button name="login_btn" width="40" height="40" bkimage="file='1385/logo@2x.png'" padding="16,16,0,0"/>
	  </CxVerticalLayout>
	  <!--展开态-->
	  <VerticalLayout name="normal_lay" width="72" height="486" borderround="16,16" bkcolor="#99000000" visible="false">
		  <Control name="top_control" height="16"/>
		  <Button name="main_btn" width="40" height="40" normalimage="file='1385/logo@2x.png'" hotimage="file='1385/logo@2x.png'" pushedimage="file='1385/logo@2x.png'" padding="16,0,0,0"/>
		  <CxVerticalLayout name="svideo_lay" width="72" height="55" padding="0,16,0,0">
			  <Button name="svideo_btn" width="72" height="55" text="短视频" indexfont="yahei_12" align="center" textpadding="0,40,0,0"
			          textcolor="#CCFFFFFF" hottextcolor="#FFFFFFFF" pushedtextcolor="#80FFFFFF"
			          normalimage="file='1385/short_video_normal@2x.png' dest='18,0,54,36'"
			          hotimage="file='1385/short_video_hover@2x.png' dest='18,0,54,36'"
			          pushedimage="file='1385/short_video_push@2x.png' dest='18,0,54,36'"/>
		  </CxVerticalLayout>
		  <CxVerticalLayout name="game_lay" width="72" height="55" padding="0,12,0,0">
		  	  <Label name="game_red_dot" float="true" pos="52,0,60,8" bkcolor="#FFF4406D" borderround="4,4"/>
			  <Button name="game_btn" width="72" height="55" text="小游戏" indexfont="yahei_12" align="center" textpadding="0,40,0,0"
			          textcolor="#CCFFFFFF" hottextcolor="#FFFFFFFF" pushedtextcolor="#80FFFFFF"
			          normalimage="file='1385/game_btn_normal@2x.png' dest='18,0,54,36'"
			          hotimage="file='1385/game_btn_hover@2x.png' dest='18,0,54,36'"
			          pushedimage="file='1385/game_btn_hover@2x.png' dest='18,0,54,36'"/>
		  </CxVerticalLayout>
		   <CxVerticalLayout name="follow_lay" width="72" height="55" padding="0,12,0,0">
		      <Button name="follow_btn" width="72" height="55" text="历史" indexfont="yahei_12" align="center" textpadding="0,40,0,0"
		              textcolor="#CCFFFFFF" hottextcolor="#FFFFFFFF" pushedtextcolor="#80FFFFFF"
		              normalimage="file='1385/history_normal@2x.png' dest='18,0,54,36'"
		              hotimage="file='1385/history_hover@2x.png' dest='18,0,54,36'"
		              pushedimage="file='1385/history_push@2x.png' dest='18,0,54,36'"/>
		  </CxVerticalLayout>
		  <CxVerticalLayout name="search_lay" width="72" height="55" padding="0,12,0,0">
			  <Button name="search_btn" width="72" height="55" text="搜索" indexfont="yahei_12" align="center" textpadding="0,40,0,0"
			  textcolor="#CCFFFFFF" hottextcolor="#FFFFFFFF" pushedtextcolor="#80FFFFFF"
			  normalimage="file='1385/search.svg' dest='18,0,54,36' "
			  hotimage="file='1385/search_hot.svg' dest='18,0,54,36'"
			  pushedimage="file='1385/search_hot.svg' dest='18,0,54,36'"/>
		  </CxVerticalLayout>
		  <CxVerticalLayout name="new_preview_lay" width="72" height="55" padding="0,12,0,0">
		  	  <Label name="new_preview_red_dot" float="true" pos="52,0,60,8" bkcolor="#FFF4406D" borderround="4,4"/>
			  <Button name="new_preview_btn" width="72" height="55" text="新片" indexfont="yahei_12" align="center" textpadding="0,40,0,0"
			          textcolor="#CCFFFFFF" hottextcolor="#FFFFFFFF" pushedtextcolor="#80FFFFFF"
			          normalimage="file='1385/new_preview_normal@2x.png' dest='18,0,54,36'"
			          hotimage="file='1385/new_preview_hover@2x.png' dest='18,0,54,36'"
			          pushedimage="file='1385/new_preview_push@2x.png' dest='18,0,54,36'"/>
		  </CxVerticalLayout>
		  <CxVerticalLayout name="more_lay" width="72" height="55" padding="0,11,0,0" visible="false">
		  	  <Label name="line_lab" width="28" height="1" padding="10,1,0,0"/>
			  <Button name="more_btn" width="72" height="55" text="更多" indexfont="yahei_12" align="center" textpadding="0,40,0,0"
			          textcolor="#CCFFFFFF" hottextcolor="#FFFFFFFF" pushedtextcolor="#80FFFFFF"
			          normalimage="file='1385/more_normal@2x.png' dest='18,0,54,36'"
			          hotimage="file='1385/more_hover@2x.png' dest='18,0,54,36'"
			          pushedimage="file='1385/more_push@2x.png' dest='18,0,54,36'"/>
		  </CxVerticalLayout>
		  <Control name="bottom_ctrl" height="24"/>
	  </VerticalLayout>
		<!--吸附态-->
	  <Button name="mini_lay" visible="false" width="24" height="88">
	  </Button>
  </VerticalLayout>
</Window>
