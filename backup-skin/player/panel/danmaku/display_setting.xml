<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<Window >
  <Font name="微软雅黑" size="14" bold="true" italic="false"  indexfont="yahei_14_b"/>	
  <Font name="微软雅黑" size="14" bold="false" italic="false"  indexfont="yahei_14"/>	
  <Font name="微软雅黑" size="12" bold="false" italic="false"  indexfont="yahei_12"/>
  
  <WeakVerticalLayout name="danmaku_display_root" width="260" maxwidth="260" minwidth="260" height="514" maxheight="514" minheight="514" visible="false"  borderround="8,8">
	  <WeakVerticalLayout width="260" maxwidth="260" minwidth="260" height="514" maxheight="514" minheight="514" bkcolor="#B2000000" borderround="8,8" >
		<WeakControl height="12"/>
		<WeakHorizontalLayout height="30" padding="16,0,0,0">
			<WeakLabel text="弹幕显示设置" width="90" height="17" padding="0,7,0,6" textcolor="#FFFFFFFF" indexfont="yahei_14_b" />
			<WeakControl />
			<WeakButton name="display_reset" text="重置" width="60" height="28" tooltip="重置弹幕显示设置" padding="0,0,16,0" indexfont="yahei_14" borderround="14,14" enabled="false"
					textcolor="player_text_color" hottextcolor="player_text_hotcolor" pushedtextcolor="player_text_pushedcolor" disabledtextcolor="player_text_disabledcolor"
					bkcolor="#FF2B2B2B" hotbkcolor="#FF101010" align="center"/>
		</WeakHorizontalLayout>
		
		<WeakControl height="11"/>
		<WeakHorizontalLayout height="16" padding="16,7,0,7">
		  <WeakLabel text="不透明度" width="56" height="14" padding="0,1,0,1" textcolor="#FFFFFFFF" indexfont="yahei_12" align="left"/>
			<DanmakuSlider name="danmaku_alpha" max="100" min="10" value="86" step="1"  width="130" height="18"  thumbbase="false" padding="5,0,0,0"
								forepadding="0,8,0,8" foregradient="linear startpoint='0,0' endpoint='1,0' colorstops=((#8000FF00, 0)(#FF00FF00, 0.3)(#FF66FF00, 1.0))" 
								bkcolor="#8078787E" bkpadding="0,8,0,8" thumbsize="6,6"  
								thumbimage="file='player/panel/danmaku/widget/danmu_color.svg' dest='0,0,6,6' 
								svg-fill-color='#FFFFFFFF'"/>
			<WeakControl width="7"/>
			<WeakLabel name="danmaku_alpha_value" text="86%" height="14" width="30" padding="0,1,16,1" textcolor="#FFFFFFFF" indexfont="yahei_12" align="right"/>
		</WeakHorizontalLayout>
			
		<WeakControl height="4"/>

		<WeakHorizontalLayout height="16" padding="16,7,0,7">
			<WeakLabel text="字号" width="56" height="16" padding="0,1,0,1" textcolor="#FFFFFFFF"  indexfont="yahei_12" align="left"/>  
			<WeakHorizontalLayout name="danmaku_font_layout" width="130" height="18" padding="5,0,0,0" >  	
				<DanmakuSlider name="danmaku_font" max="4" min="1" value="2" step="1"  actualdest="0,8,130,9" archorcount="4" thumbbase="false" 
							forepadding="0,8,0,8" foregradient="linear startpoint='0,0' endpoint='1,0' colorstops=((#8000FF00, 0)(#FF00FF00, 0.3)(#FF66FF00, 1.0))" 
							bkcolor="#8078787E" bkpadding="0,8,0,8" thumbsize="6,6"  thumbimage="file='player/panel/danmaku/widget/danmu_color.svg' dest='0,0,6,6' 
							svg-fill-color='#FFFFFFFF'"/>
			</WeakHorizontalLayout>
				
			<WeakControl width="10"/>
			<WeakLabel name="danmaku_font_value" text="标准" height="14" width="27" padding="0,1,16,1" textcolor="#FFFFFFFF" indexfont="yahei_12" align="right"/>
		</WeakHorizontalLayout>
			
		<WeakControl height="4"/>
			
		<WeakHorizontalLayout height="16" padding="16,7,0,7">
			<WeakLabel text="速度" width="56" height="16" padding="0,1,0,1" textcolor="#FFFFFFFF"  indexfont="yahei_12" align="left"/>
			<DanmakuSlider name="danmaku_speed" min="5" max="25"  value="10" step="1"  width="130" height="18" thumbbase="false" padding="6,0,0,0"
								forepadding="0,8,0,8" foregradient="linear startpoint='0,0' endpoint='1,0' colorstops=((#8000FF00, 0)(#FF00FF00, 0.3)(#FF66FF00, 1.0))" 
								bkcolor="#8078787E" bkpadding="0,8,0,8" thumbsize="6,6"  thumbimage="file='player/panel/danmaku/widget/danmu_color.svg' dest='0,0,6,6' 
								svg-fill-color='#FFFFFFFF'"/>
			<WeakControl width="10"/>
			<WeakLabel name="danmaku_speed_value" text="0.8x" height="14" width="27" padding="0,1,16,1" textcolor="#FFFFFFFF" indexfont="yahei_12" align="right"/>
		</WeakHorizontalLayout>
		
		<WeakControl height="4"/>
			
		<WeakHorizontalLayout height="16" padding="16,7,0,7">
			<WeakLabel text="显示区域" width="56" height="16" padding="0,1,0,1" textcolor="#FFFFFFFF"  indexfont="yahei_12" align="left"/>
			<DanmakuSlider name="danmaku_show_area" max="100" min="10" value="30" step="10"  width="130" height="18"  thumbbase="false" padding="6,0,0,0"
							forepadding="0,8,0,8" foregradient="linear startpoint='0,0' endpoint='1,0' colorstops=((#8000FF00, 0)(#FF00FF00, 0.3)(#FF66FF00, 1.0))" 
								bkcolor="#8078787E" bkpadding="0,8,0,8" thumbsize="6,6"  thumbimage="file='player/panel/danmaku/widget/danmu_color.svg' dest='0,0,6,6' 
								svg-fill-color='#FFFFFFFF'"/>
			<WeakControl width="7"/>
			<WeakLabel name="danmaku_show_area_value" text="30%" height="14" width="30" padding="0,1,16,1" textcolor="#FFFFFFFF"  indexfont="yahei_12" align="rightmiddle" />
		</WeakHorizontalLayout>	
		
		<WeakControl height="20"/>
		<WeakControl height="1" bkcolor="#19FFFFFF" padding="16,0,16,0"/>
		<WeakControl height="20"/>
		
		<WeakHorizontalLayout height="14" padding="16,0,0,0" >
			<WeakLabel text="智能防剧透" width="70" height="14" padding="0,0,36,0" textcolor="#FFFFFFFF"  indexfont="yahei_14" align="left" />
			
			<WeakLabel name="spoiler_text" text="屏蔽更多潜在剧透弹幕"  height="12" padding="0,1,16,1" textcolor="#80FFFFFF"  indexfont="yahei_12" align="right" />
		</WeakHorizontalLayout>
		
		<WeakHorizontalLayout height="14" padding="16,7,0,7">			
			<DanmakuSlider name="danmaku_spoiler" max="2" width="192" min="0" value="0" step="1"  actualdest="0,8,130,9" archorcount="3" thumbbase="false" 
							forepadding="0,8,0,8" foregradient="linear startpoint='0,0' endpoint='1,0' colorstops=((#8000FF00, 0)(#FF00FF00, 0.3)(#FF66FF00, 1.0))" 
							bkcolor="#8078787E" bkpadding="0,8,0,8" thumbsize="6,6"  thumbimage="file='player/panel/danmaku/widget/danmu_color.svg' dest='0,0,6,6' 
							svg-fill-color='#FFFFFFFF'"/>
			
			<WeakControl width="9"/>
			<WeakLabel name="danmaku_spoiler_value" text="0级" height="14" width="27" padding="0,1,16,1" textcolor="#FFFFFFFF" indexfont="yahei_12" align="rightmiddle" />
			<WeakControl />
		</WeakHorizontalLayout>
		
		<WeakControl height="20"/>
		<WeakControl height="1" bkcolor="#19FFFFFF" padding="16,0,16,0"/>
		<WeakControl height="20"/>
		
		<WeakHorizontalLayout height="20" padding="16,5,16,5">
			<WeakLabel text="默认开启弹幕" width="90" height="18" padding="0,1,0,1" textcolor="#FFFFFFFF"  indexfont="yahei_14_b" align="left"/>	
			<WeakControl />			
			<WeakCheckBox name="defaultopendanmu" visible="true"   width="35" height="20"                            
							  normalimage="file='player/panel/danmaku/widget/default_close.svg' 
											svg-fill-color='radio_checkbox_normal_color'
											hot-svg-fill-color='radio_checkbox_hot_color'
											pushed-svg-fill-color='radio_checkbox_pushed_color'"  
							  selectednormalimage="file='player/panel/danmaku/widget/default_open.svg' 	svg-fill-color='radio_checkbox_selected_normal_color'"
							  selectedhotimage="file='player/panel/danmaku/widget/default_open.svg' 	svg-fill-color='radio_checkbox_selected_hot_color'"
							  selectedpushedimage="file='player/panel/danmaku/widget/default_open.svg' 	svg-fill-color='radio_checkbox_selected_pushed_color'"/>
						
		</WeakHorizontalLayout>
			
		<WeakControl height="14"/>
		<WeakLabel text="屏蔽设置" width="100" height="16" padding="16,7,0,7" textcolor="#FFFFFFFF"  indexfont="yahei_14_b" align="left"/>
		<WeakControl height="10"/>
		<WeakHorizontalLayout padding="22,0,0,0">
			<WeakVerticalLayout width="30">
				<WeakOption name="danmaku_shield_color_text"   height="30"  visible="true" 
										tooltip="屏蔽后新出现的弹幕均为白色" 
										normalimage="file='player/panel/danmaku/widget/shield_color.svg' 
										svg-fill-color='player_control_normal_color'
										hot-svg-fill-color='player_control_hover_color'
										pushed-svg-fill-color='player_control_press_color'" />
				<WeakLabel text="彩色"  height="16"  textcolor="#FFFFFFFF"  indexfont="yahei_12" align="left"/>
			</WeakVerticalLayout>
			<WeakVerticalLayout padding="10,0,0,0" width="52" name="mask_layout">
				<WeakOption name="danmaku_mask" width="30"  height="30"  visible="true" padding="12,0,0,0"
										tooltip="开启后弹幕将不再遮挡人像区域"  
										normalimage="file='player/panel/danmaku/widget/mask_close.svg' 
										svg-fill-color='player_control_normal_color'
										hot-svg-fill-color='player_control_hover_color'
										pushed-svg-fill-color='player_control_press_color'" />
				<WeakLabel text="人像区域" width="54" height="16" padding="0,0,0,0" textcolor="#FFFFFFFF"  indexfont="yahei_12" align="center"/>
			</WeakVerticalLayout>
			<WeakControl />
		</WeakHorizontalLayout>
		<WeakControl height="14"/>
		<WeakHorizontalLayout height="30" padding="16,0,0,12" >
			<WeakButton name="screen_words" text="设置屏蔽词" width="82" height="30"   indexfont="yahei_14_b" align="left" 
					textcolor="#FFFFFFFF" hottextcolor="#FF00BE06" pushedtextcolor="#FF00B606" textpadding="0,7,12,7"
					normalimage="file='player/panel/danmaku/screen_setting/go.svg' dest='70,9,82,23' "
						hotimage="file='player/panel/danmaku/screen_setting/go_hover.svg' dest='70,9,82,23' "
						pushedimage="file='player/panel/danmaku/screen_setting/go_pushed.svg' dest='70,9,82,23'"/>
			<WeakControl />
		</WeakHorizontalLayout>
	  </WeakVerticalLayout>
	  <WeakControl height="40"  bkcolor="#01010000"/>
  </WeakVerticalLayout>
</Window>